# Existing StarCat / MSSQL settings
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=StarCat10
DB_USER=
DB_PASSWORD=
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true

# Hikvision NVR monitoring
# JSON array. Keep real passwords only in the server .env; never commit them.
HIKVISION_PROTOCOL=http
HIKVISION_NVR_CONFIG='[{"id":"nvr-001","name":"NVR-001","host":"192.168.1.100","port":80,"username":"admin","password":"CHANGE_ME","site":"Site A"}]'
